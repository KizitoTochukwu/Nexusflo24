{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://stuaikfyuwcjmchcvfie.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "nexusflo24-mcp",
      "version": "0.2.0",
      "title": "NexusFlo24 AI Agent Connections"
    },
    "tools": [
      {
        "name": "list_workspaces",
        "title": "List workspaces",
        "description": "List the signed-in user's NexusFlo24 workspaces. Use the returned workspace_id when calling other tools.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_workspace_summary",
        "title": "Get workspace summary",
        "description": "Get a high-level NexusFlo24 workspace snapshot: workspace name plus total leads, hot leads, upcoming appointments, active campaigns and active automations.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "workspace_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_leads",
        "title": "List leads",
        "description": "List the most recent NexusFlo24 leads for the signed-in user's workspace (name, email, phone, status, stage, score, source, tags, created_at). Optional workspace_id, status, and search filters. Max 50 rows.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "workspace_id": {
              "type": "string",
              "format": "uuid",
              "description": "Optional workspace to scope leads to."
            },
            "status": {
              "type": "string",
              "description": "Optional status filter (e.g. New, Warm, Hot)."
            },
            "search": {
              "type": "string",
              "description": "Optional case-insensitive match on name or email."
            },
            "limit": {
              "type": "integer",
              "description": "Max rows to return (default 25, max 50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_lead",
        "title": "Get lead",
        "description": "Get a single NexusFlo24 lead by id, including status, stage, score, source, tags and notes.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "lead_id": {
              "type": "string",
              "format": "uuid",
              "description": "The lead to fetch."
            },
            "workspace_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "lead_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_hot_leads",
        "title": "List hot leads",
        "description": "List the workspace's hottest NexusFlo24 leads — highest lead score first, optionally only those above a minimum score. Max 50 rows.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "workspace_id": {
              "type": "string",
              "format": "uuid"
            },
            "min_score": {
              "type": "integer",
              "description": "Minimum lead score (default 81 = Hot)."
            },
            "limit": {
              "type": "integer"
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_campaigns",
        "title": "List campaigns",
        "description": "List the workspace's NexusFlo24 marketing campaigns (Email / WhatsApp / SMS) with channel, status and schedule. Max 50 rows.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "workspace_id": {
              "type": "string",
              "format": "uuid"
            },
            "status": {
              "type": "string"
            },
            "limit": {
              "type": "integer"
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_campaign_performance",
        "title": "Get campaign performance",
        "description": "Get NexusFlo24 campaign performance — sent count, open rate, click rate and conversion rate — for one campaign or the workspace's most recent campaigns.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
