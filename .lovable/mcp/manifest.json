        "inputSchema": {
          "type": "object",
          "properties": {
            "workspace_id": {
              "type": "string",
              "format": "uuid"
            },
            "campaign_id": {
              "type": "string",
              "format": "uuid",
              "description": "Optional single campaign to report on."
            },
            "limit": {
              "type": "integer"
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_appointments",
        "title": "List appointments",
        "description": "List NexusFlo24 appointments (bookings) for the workspace, optionally within a date range or by status. Returns guest name, time, status and location. Max 50 rows.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "workspace_id": {
              "type": "string",
              "format": "uuid"
            },
            "from": {
              "type": "string",
              "description": "ISO start of range (default now)."
            },
            "to": {
              "type": "string",
              "description": "ISO end of range."
            },
            "status": {
              "type": "string",
              "description": "Optional status filter (confirmed, cancelled, completed)."
            },
            "limit": {
              "type": "integer"
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_conversations",
        "title": "List conversations",
        "description": "List recent NexusFlo24 customer conversation messages across Email, SMS and WhatsApp, with channel, direction, intent and status. Max 50 rows.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "workspace_id": {
              "type": "string",
              "format": "uuid"
            },
            "lead_id": {
              "type": "string",
              "format": "uuid",
              "description": "Optional lead to scope the conversation to."
            },
            "channel": {
              "type": "string",
              "description": "Optional channel filter (email, sms, whatsapp)."
